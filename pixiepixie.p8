pico-8 cartridge // http://www.pico-8.com
version 43
__lua__

#include target.lua
#include game.lua
#include matrix.lua
#include panel.lua
#include queue.lua

t=nil
m=nil
lk=0
lv=0
q=nil
sc=0
ver = "2026.alpha1"

function _draw()
  cls()
  map()
  draw_m(get_lc())
  draw_t()
  draw_q()
  if q.d>=3 then
    rectfill(28,54,100,74,0)
    rect(28,54,100,74,7)
    print("game over",38,62,7)
  end
end

function _init()
  cartdata("pixiepixie")
  init_game()

  init_t()
  init_m()
  init_q()
end

function _update()
  upd_input()
  upd_m()
  upd_q()
end

